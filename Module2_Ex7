// -------------------- ЗАДАНИЕ 2 --------------------

@Composable
fun Task7ContactCard(
    contact: Task7Contact
) {

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .background(Color(0xFFD9D9D9))
            .padding(8.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {

        Text("Имя: ${contact.name}")
        Text("Отчество: ${contact.patronymic}")
        Text("Фамилия: ${contact.surname}")
        Text("Мобильный телефон: ${contact.phone}")
        Text("Адрес: ${contact.address}")
    }
}


@Composable
fun Task7ContactsListScreen(
    contacts: List<Task7Contact>
) {

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.White)
    ) {

        Task7Header()

        Column(
            modifier = Modifier
                .fillMaxWidth()
                .padding(4.dp),
            verticalArrangement = Arrangement.spacedBy(4.dp)
        ) {

            contacts.forEach { contact ->
                Task7ContactCard(contact)
            }
        }
    }
}


