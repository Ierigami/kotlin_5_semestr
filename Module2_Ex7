@Composable
fun Task7ContactRow(
    contact: Task7Contact
) {

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 8.dp)
            .background(Color(0xFFD9D9D9))
            .padding(8.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {

        Column(
            modifier = Modifier.weight(1f),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {

            Text("Имя: ${contact.name}")
            Text("Отчество: ${contact.patronymic}")
            Text("Фамилия: ${contact.surname}")
            Text("Мобильный телефон: ${contact.phone}")
            Text("Адрес: ${contact.address}")
        }

        Spacer(
            modifier = Modifier.width(8.dp)
        )

        Image(
            painter = painterResource(
                id = android.R.drawable.btn_star_big_on
            ),
            contentDescription = "Избранное",
            modifier = Modifier.size(24.dp)
        )
    }
}


