package com.example.module2

import androidx.activity.ComponentActivity
import androidx.compose.material3.MaterialTheme
import androidx.compose.ui.test.assertIsDisplayed
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.onNodeWithText
import androidx.compose.ui.test.performClick
import org.junit.Rule
import org.junit.Test

class WaterTrackerTest {

    @get:Rule
    val composeTestRule =
        createAndroidComposeRule<ComponentActivity>()

    private fun setScreen() {
        composeTestRule.setContent {
            MaterialTheme {
                WaterTracker()
            }
        }
    }

    @Test
    fun addButton_incrementsBy250() {
        setScreen()

        composeTestRule
            .onNodeWithText("0 мл")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithTag("addButton")
            .assertIsDisplayed()
            .performClick()

        composeTestRule
            .onNodeWithText("250 мл")
            .assertIsDisplayed()
    }

    @Test
    fun finishDay_reachesThreshold_incrementsStreakAndResetsWater() {
        setScreen()

        repeat(6) {
            composeTestRule
                .onNodeWithTag("addButton")
                .performClick()
        }

        composeTestRule
            .onNodeWithText("1500 мл")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithTag("finishDayButton")
            .assertIsDisplayed()
            .performClick()

        composeTestRule
            .onNodeWithText("0 мл")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithText("Серия дней ≥ 1500 мл: 1")
            .assertIsDisplayed()
    }

    @Test
    fun streakText_exists_andResetsIfBelowThreshold() {
        setScreen()

        composeTestRule
            .onNodeWithTag("streakText")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithText("Серия дней ≥ 1500 мл: 0")
            .assertIsDisplayed()

        repeat(5) {
            composeTestRule
                .onNodeWithTag("addButton")
                .performClick()
        }

        composeTestRule
            .onNodeWithText("1250 мл")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithTag("finishDayButton")
            .performClick()

        composeTestRule
            .onNodeWithText("0 мл")
            .assertIsDisplayed()

        composeTestRule
            .onNodeWithText("Серия дней ≥ 1500 мл: 0")
            .assertIsDisplayed()
    }
}
